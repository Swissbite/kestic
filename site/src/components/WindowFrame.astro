// A cropped screenshot in a plain Breeze-like window frame with a numbered
// mono caption. The picture links to the full PNG; inside <Lightbox> the link
// opens the lightbox instead.

import type { Screenshot } from "../screenshots.ts";

interface Props {
  shot: Screenshot;
  number: number;
  eager?: boolean;
}

const { shot, number, eager = false } = Astro.props;
const src = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/screenshots/${shot.file}`;
const { crop } = shot;
const percent = (ratio: number): string => `${(ratio * 100).toFixed(4)}%`;
const cropStyle = [
  `aspect-ratio: ${crop.width} / ${crop.height}`,
  `--img-width: ${percent(shot.width / crop.width)}`,
  `--img-left: ${percent(-crop.x / crop.width)}`,
  `--img-top: ${percent(-crop.y / crop.height)}`,
].join("; ");
---

<figure class="frame">
  <div class="window">
    <div class="titlebar" aria-hidden="true">
      <span class="title">Kestic</span>
      <span class="buttons"><span class="btn min"></span><span class="btn max"></span><span class="btn close"></span></span>
    </div>
    <a
      class="open"
      href={src}
      data-lightbox
      data-caption={shot.caption}
      data-focus-x={crop.x / shot.width}
      data-focus-y={crop.y / shot.height}
      style={cropStyle}
    >
      <img
        src={src}
        alt={shot.alt}
        width={shot.width}
        height={shot.height}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
      <span class="enlarge mono" aria-hidden="true">Enlarge&nbsp;⤢</span>
    </a>
  </div>
  <figcaption class="mono">
    <span class="accent">{String(number).padStart(2, "0")}</span>
    <span class="mute">{shot.caption}</span>
  </figcaption>
</figure>

<style>
  .frame {
    margin: 0;
  }
  .window {
    border: 1px solid #17191b;
    border-radius: 7px 7px 2px 2px;
    overflow: hidden;
    background: #eff0f1;
  }
  @media (prefers-color-scheme: dark) {
    .window {
      border-color: #4a4d52;
    }
  }
  .titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 30px;
    padding: 0 10px 0 12px;
    background: #dee0e2;
    border-bottom: 1px solid #c4c7ca;
    color: #232629;
    font-family: "Noto Sans", var(--sans);
    font-size: 12px;
  }
  .buttons {
    display: flex;
    gap: 10px;
  }
  .btn {
    position: relative;
    width: 14px;
    height: 14px;
    border-radius: 50%;
  }
  .btn.min::after {
    content: "";
    position: absolute;
    left: 3px;
    right: 3px;
    top: 6px;
    height: 1.5px;
    background: #232629;
  }
  .btn.max::after {
    content: "";
    position: absolute;
    inset: 3px;
    border: 1.5px solid #232629;
    transform: rotate(45deg) scale(0.75);
    border-right: 0;
    border-bottom: 0;
    top: 5px;
  }
  .btn.close {
    background: #da4453;
  }
  .btn.close::before,
  .btn.close::after {
    content: "";
    position: absolute;
    left: 3px;
    right: 3px;
    top: 6px;
    height: 1.5px;
    background: #fff;
    transform: rotate(45deg);
  }
  .btn.close::after {
    transform: rotate(-45deg);
  }
  .open {
    display: block;
    position: relative;
    overflow: hidden;
    cursor: zoom-in;
  }
  .open img {
    position: absolute;
    left: var(--img-left);
    top: var(--img-top);
    width: var(--img-width);
    max-width: none;
  }
  .open:focus-visible {
    outline-offset: -2px;
  }
  .enlarge {
    position: absolute;
    right: 8px;
    bottom: 8px;
    padding: 3px 8px;
    background: #17191b;
    color: #ece9e2;
    font-size: 12px;
    border-radius: 2px;
  }
  .open:hover .enlarge,
  .open:focus-visible .enlarge {
    background: var(--accent);
    color: #fff;
  }
  .window:has(.open:hover) {
    border-color: var(--accent);
  }
  @media (prefers-color-scheme: dark) {
    .open img {
      filter: brightness(0.88);
    }
    .open:hover img,
    .open:focus-visible img {
      filter: none;
    }
  }
  figcaption {
    display: flex;
    gap: 10px;
    margin-top: 10px;
    font-size: 13px;
  }
</style>
