// A screenshot in a plain Breeze-like window frame with a mono caption.

import type { Screenshot } from "../screenshots.ts";

interface Props {
  shot: Screenshot;
  eager?: boolean;
}

const { shot, eager = false } = Astro.props;
const src = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/screenshots/${shot.file}`;
---

<figure class="frame">
  <div class="window">
    <div class="titlebar" aria-hidden="true">
      <span class="title">Kestic</span>
      <span class="buttons"><span class="btn min"></span><span class="btn max"></span><span class="btn close"></span></span>
    </div>
    <img
      src={src}
      alt={shot.alt}
      width={shot.width}
      height={shot.height}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
  </div>
  <figcaption class="mono mute">{shot.caption}</figcaption>
</figure>

<style>
  .frame {
    margin: 0;
  }
  .window {
    border: 1px solid #17191b;
    border-radius: 7px 7px 2px 2px;
    overflow: hidden;
    background: #eff0f1;
  }
  @media (prefers-color-scheme: dark) {
    .window {
      border-color: #4a4d52;
    }
  }
  .titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 30px;
    padding: 0 10px 0 12px;
    background: #dee0e2;
    border-bottom: 1px solid #c4c7ca;
    color: #232629;
    font-family: "Noto Sans", var(--sans);
    font-size: 12px;
  }
  .buttons {
    display: flex;
    gap: 10px;
  }
  .btn {
    position: relative;
    width: 14px;
    height: 14px;
    border-radius: 50%;
  }
  .btn.min::after {
    content: "";
    position: absolute;
    left: 3px;
    right: 3px;
    top: 6px;
    height: 1.5px;
    background: #232629;
  }
  .btn.max::after {
    content: "";
    position: absolute;
    inset: 3px;
    border: 1.5px solid #232629;
    transform: rotate(45deg) scale(0.75);
    border-right: 0;
    border-bottom: 0;
    top: 5px;
  }
  .btn.close {
    background: #da4453;
  }
  .btn.close::before,
  .btn.close::after {
    content: "";
    position: absolute;
    left: 3px;
    right: 3px;
    top: 6px;
    height: 1.5px;
    background: #fff;
    transform: rotate(45deg);
  }
  .btn.close::after {
    transform: rotate(-45deg);
  }
  img {
    width: 100%;
  }
  figcaption {
    margin-top: 10px;
    font-size: 12px;
  }
</style>
