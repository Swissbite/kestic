// Signature element: the snapshots a retention of 12 monthly, 4 weekly and
// 7 daily keeps, laid out on a time axis that ends at «now».

const monthly = Array.from({ length: 12 }, (_, i) => 6 + i * 50);
const weekly = Array.from({ length: 4 }, (_, i) => 640 + i * 52);
const daily = Array.from({ length: 7 }, (_, i) => 852 + i * 19);
const height = 76;
const axis = 34;
---

<div class="timeline">
  <svg
    viewBox={`0 0 1000 ${height}`}
    preserveAspectRatio="none"
    role="img"
    aria-label="Retention as a timeline: 12 monthly, 4 weekly and 7 daily snapshots are kept up to now."
  >
    <line x1="0" y1={axis} x2="1000" y2={axis} class="axis" />
    {monthly.map((x) => <line x1={x} x2={x} y1={axis - 14} y2={axis + 14} class="tick" />)}
    {weekly.map((x) => <line x1={x} x2={x} y1={axis - 10} y2={axis + 10} class="tick" />)}
    {daily.map((x) => <line x1={x} x2={x} y1={axis - 6} y2={axis + 6} class="tick daily" />)}
  </svg>
  <span class="now" style={`top: ${axis}px`} aria-hidden="true"></span>
</div>
<div class="labels mono mute" aria-hidden="true">
  <span>12 monthly</span>
  <span class="weekly">4 weekly</span>
  <span class="daily-label">7<span class="long">&nbsp;daily</span></span>
  <span class="now-label accent">now</span>
</div>

<style>
  .timeline {
    position: relative;
    color: var(--ink);
  }
  .timeline svg {
    width: 100%;
    height: 76px;
  }
  .axis {
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .tick {
    stroke: currentColor;
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
  }
  .tick.daily {
    stroke: var(--accent);
  }
  .now {
    position: absolute;
    right: 2px;
    width: 12px;
    height: 12px;
    margin-top: -6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .labels {
    position: relative;
    height: 20px;
    margin-top: 2px;
    font-size: 12px;
  }
  .labels span {
    position: absolute;
    top: 0;
    white-space: nowrap;
  }
  .labels .weekly {
    left: 64%;
  }
  .labels .daily-label {
    left: 85.2%;
  }
  .labels .now-label {
    right: 0;
  }
  @media (max-width: 560px) {
    .labels .long {
      display: none;
    }
  }
</style>
