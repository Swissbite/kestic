// SPDX-License-Identifier: GPL-3.0-or-later

import Base from "../layouts/Base.astro";
import RetentionTimeline from "../components/RetentionTimeline.astro";
import Lightbox from "../components/Lightbox.astro";
import WindowFrame from "../components/WindowFrame.astro";
import appIcon from "../../../packaging/icons/hicolor/scalable/apps/kestic.svg";
import { heroShot, galleryShots } from "../screenshots.ts";
import { buildShaShort, commitUrl, repoUrl } from "../build-info.ts";

const features = [
  {
    term: "Exclude rules",
    text: "Pick folders to skip, or switch to expert mode for raw restic patterns. A linter flags exceptions that can never match.",
  },
  {
    term: "Backup preview",
    text: "A dry run lists the files a backup would include and how much data it would add, before anything is written.",
  },
  {
    term: "Retention",
    text: "Keep the last n per hour, day, week, month, or year, or everything within a period. A preview shows which snapshots forget would remove.",
  },
  {
    term: "Schedule",
    text: "Daily, on chosen weekdays, weekly, or every few days. Runs missed during sleep or shutdown are caught up, and overdue backups are flagged.",
  },
  {
    term: "Run conditions",
    text: "Only on AC power, only with a network, never on a metered connection, only on the Wi-Fi networks you allow.",
  },
  {
    term: "Maintenance",
    text: "Clean up and Verify run per destination on a calendar you set. They wait for running backups and start only on AC power and an unmetered network.",
  },
  {
    term: "Pause",
    text: "Hold all schedules for an hour, until tomorrow, or until you resume. Manual backups still run.",
  },
  {
    term: "At home on Plasma",
    text: "A Kirigami app, a tray entry, notifications, and progress in the Plasma panel. Passwords live in KWallet, through the Secret Service.",
  },
] as const;

const milestones = [
  {
    id: "M0",
    name: "Spike",
    scope: "Toolchain proven: CXX-Qt, packaging, Secret Service, translations, tray.",
    done: true,
  },
  {
    id: "M1",
    name: "Walking skeleton",
    scope: "One backup through every layer, from the window to restic and back, installable as a .deb.",
    done: true,
  },
  {
    id: "M2",
    name: "Backup configuration",
    scope: "Exclude rules, retention with preview, source checks.",
    done: true,
  },
  {
    id: "M3",
    name: "Automation",
    scope: "Schedule, run conditions, retries, overdue backups, maintenance, sleep.",
    done: true,
  },
  {
    id: "M4",
    name: "Restore",
    scope: "Browse, compare, and restore snapshots without overwriting anything by accident.",
    done: false,
  },
  {
    id: "M5",
    name: "Destinations and restic provisioning",
    scope: "Every restic backend, and a bundled restic where the system one is too old.",
    done: false,
  },
  {
    id: "M6",
    name: "Onboarding and security",
    scope: "A first backup in five steps, a recovery kit, and your data back on a new computer.",
    done: false,
  },
] as const;

const doneCount = milestones.filter((m) => m.done).length;
const nextMilestone = milestones.find((m) => !m.done);
const buildFromSource = `${repoUrl}#building--testing`;
---

<Base
  title="Kestic: restic backups for KDE Plasma"
  description="A native KDE Plasma backup manager powered by restic. Pick what and where. Kestic does the rest, with every restic option within reach."
>
  <div class="preview-bar mono">
    <div class="wrap">
      <span>Development preview, built from main @ <a href={commitUrl}>{buildShaShort}</a>.</span>
      <span class="mute">No release yet.</span>
    </div>
  </div>

  <header class="site-header">
    <div class="wrap header-inner">
      <a class="wordmark" href={import.meta.env.BASE_URL} aria-label="Kestic home">
        <img src={appIcon.src} alt="" width="28" height="28" />
        <span>kestic</span>
      </a>
      <nav aria-label="Sections" class="mono">
        <a href="#features">Features</a>
        <a href="#roadmap">Roadmap</a>
        <a href="#screens">Screens</a>
        <a href="#how">How it works</a>
        <a href={repoUrl}>GitHub&nbsp;↗</a>
      </nav>
    </div>
  </header>

  <Lightbox>
    <main id="main">
      <section class="hero wrap">
        <p class="mono accent eyebrow">
          <a href="#roadmap">In development · {doneCount} of {milestones.length} milestones done</a>
        </p>
        <h1>
          <span>Backups that run themselves.</span>
          <span class="second">On Plasma. With restic.</span>
        </h1>
        <p class="lede">
          Pick what and where. Kestic does the rest, with every restic option within reach.
        </p>
        <div class="actions">
          <a class="button primary" href={repoUrl}>View on GitHub</a>
          <a class="button" href={buildFromSource}>Build from source</a>
        </div>
        <p class="mono mute install">
          For KDE Plasma 6 on Debian- and Ubuntu-based systems, with restic 0.18.0 or newer. No
          release yet: build the .deb with <code>just deb</code>.
        </p>
      </section>

      <div class="wrap timeline-hero">
        <RetentionTimeline />
      </div>

      <div class="wrap hero-shot">
        <WindowFrame shot={heroShot} number={1} eager />
        <p class="mono mute provenance">
          Rendered by the test suite at <a href={commitUrl}>{buildShaShort}</a>. Every screenshot on
          this page is.
        </p>
      </div>

      <section id="features" class="section wrap">
        <div class="section-head">
          <h2>What it does</h2>
          <p>Everything below works today. Restore and onboarding follow in the next milestones.</p>
        </div>
        <ol class="features">
          {
            features.map((f, i) => (
              <li>
                <span class="num mono accent">{String(i + 1).padStart(2, "0")}</span>
                <span class="term">{f.term}</span>
                <span class="text">{f.text}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="roadmap" class="section wrap">
        <div class="section-head">
          <h2>Roadmap</h2>
          <p>
            {doneCount} of {milestones.length} milestones done.{" "}
            {nextMilestone ? `Next up: ${nextMilestone.id} ${nextMilestone.name}.` : "All milestones done."}{" "}
            Every story and acceptance criterion lives in the repository.
          </p>
        </div>
        <ol class="milestones">
          {
            milestones.map((m) => {
              const state = m.done ? "done" : m === nextMilestone ? "next" : "open";
              return (
                <li class={state}>
                  <span class="id">{m.id}</span>
                  <span class="bar" aria-hidden="true" />
                  <span class="what">
                    <span class="name">{m.name}</span>
                    <span class="scope">{m.scope}</span>
                  </span>
                  <span class="mono state">{state}</span>
                </li>
              );
            })
          }
        </ol>
      </section>

      <section id="screens" class="section wrap">
        <div class="section-head">
          <h2>Screens</h2>
          <p>
            Straight from the offscreen GUI tests, with their test data. Select a picture to see the
            whole window.
          </p>
        </div>
        <div class="gallery">
          {galleryShots.map((shot, i) => <WindowFrame shot={shot} number={i + 2} />)}
        </div>
      </section>

      <div class="wrap section-divider" aria-hidden="true">
        <RetentionTimeline divider />
      </div>

      <section id="how" class="section wrap">
        <div class="section-head">
          <h2>No magic</h2>
          <p>
            Every action is a restic command you can inspect. Kestic shows it next to each backup and
            in the history of every run.
          </p>
        </div>
        <pre class="command mono" aria-label="Example restic command run by Kestic"><code><span class="comment"># What "Back Up Now" runs, as shown by "Show Command"</span>
RESTIC_PASSWORD_COMMAND='kestic secret get &lt;destination-id&gt;' \
  ionice -c 3 nice -n 10 restic -r rest:https://nas.example/kestic \
  --json backup --tag kestic:&lt;backup-id&gt; --group-by tags \
  --exclude-caches --exclude-file excludes.txt -- /home/you<span class="cursor" aria-hidden="true"></span></code></pre>
        <p class="note">
          Passwords never appear on the command line or in a config file. restic asks for them
          through <code class="mono">RESTIC_PASSWORD_COMMAND</code>, and Kestic reads them from the
          password store.
        </p>

        <ol class="flow" aria-label="How the parts work together">
          <li>
            <span class="mono accent">App</span>
            <strong>Kestic</strong>
            <span>Kirigami window for setup, status, and history.</span>
          </li>
          <li>
            <span class="mono accent">D-Bus</span>
            <strong>Background service</strong>
            <span>Runs in your session, starts with Plasma, owns all runs. No root, no systemd timers.</span>
          </li>
          <li>
            <span class="mono accent">Process</span>
            <strong>restic</strong>
            <span>System restic 0.18.0 or newer does the actual work.</span>
          </li>
          <li>
            <span class="mono accent">Repository</span>
            <strong>Destination</strong>
            <span>A local folder or drive, or a REST server. More backends follow in M5.</span>
          </li>
        </ol>
      </section>

    </main>
  </Lightbox>

  <footer class="site-footer mono">
    <div class="wrap footer-inner">
      <span>Kestic · GPL-3.0-or-later · <a href={repoUrl}>Source on GitHub</a></span>
      <span class="mute">Development preview · main @ <a href={commitUrl}>{buildShaShort}</a></span>
      <span class="mute fonts">Set in Schibsted Grotesk and IBM Plex Mono, both under the SIL Open Font License 1.1.</span>
    </div>
  </footer>
</Base>

<style>
  .preview-bar {
    border-bottom: 1px solid var(--rule);
    font-size: 12px;
    padding: 8px 0;
  }
  .preview-bar .wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    justify-content: space-between;
  }
  .site-header {
    border-bottom: 1px solid var(--rule);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    flex-wrap: wrap;
  }
  .wordmark {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 21px;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .site-header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    color: var(--mute);
  }
  .site-header nav a {
    text-decoration: none;
  }
  .site-header nav a:last-child {
    color: var(--ink);
  }
  .hero {
    padding-top: clamp(48px, 9vw, 120px);
  }
  .eyebrow {
    margin: 0 0 20px;
  }
  .eyebrow a {
    text-decoration: none;
  }
  .eyebrow a:hover {
    text-decoration: underline;
  }
  .eyebrow::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 10px;
    background: currentColor;
    vertical-align: 1px;
  }
  h1 {
    margin: 0;
    font-size: clamp(44px, 9vw, 112px);
    line-height: 0.94;
    font-weight: 800;
    letter-spacing: -0.045em;
  }
  h1 span {
    display: block;
    text-wrap: balance;
  }
  h1 .second {
    color: var(--second);
  }
  .lede {
    max-width: 30em;
    margin: 32px 0 32px;
    font-size: clamp(18px, 2vw, 21px);
    color: var(--body);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .button {
    display: inline-block;
    padding: 12px 18px;
    border: 1.5px solid var(--ink);
    border-radius: 2px;
    font-weight: 500;
    font-size: 15px;
    text-decoration: none;
  }
  .button.primary {
    background: var(--ink);
    color: var(--paper);
  }
  .button:hover {
    border-color: var(--accent);
  }
  .button.primary:hover {
    background: var(--accent);
    color: var(--paper);
  }
  .install {
    max-width: 44em;
    margin: 20px 0 0;
    font-size: 12px;
    line-height: 1.6;
  }
  .install code {
    color: var(--ink);
  }
  .timeline-hero {
    padding-top: clamp(48px, 7vw, 80px);
  }
  .hero-shot {
    padding-top: 40px;
  }
  .provenance {
    margin: 6px 0 0;
    font-size: 12px;
  }
  .features {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }
  .features li {
    display: grid;
    grid-template-columns: 56px minmax(0, 220px) minmax(0, 1fr);
    gap: 16px;
    padding: 20px 0;
    border-top: 1px solid var(--rule);
    align-items: baseline;
  }
  .features .term {
    font-weight: 500;
    font-size: 19px;
  }
  .features .text {
    color: var(--body);
    max-width: 38em;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px 32px;
  }
  .section-divider {
    padding-top: clamp(56px, 9vw, 112px);
  }
  .command {
    margin: 0;
    padding: 24px 26px;
    background: var(--block-bg);
    color: var(--block-text);
    border: 1px solid var(--rule);
    border-radius: 2px;
    font-size: 14px;
    line-height: 1.75;
    overflow-x: auto;
  }
  .command .comment {
    color: var(--block-mute);
  }
  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 4px;
    vertical-align: -0.15em;
    background: #ee9164;
  }
  .note {
    max-width: 38em;
    margin: 20px 0 0;
    color: var(--body);
  }
  .note code {
    font-size: 0.85em;
  }
  .flow {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1.5px solid var(--ink);
  }
  .flow li {
    display: grid;
    gap: 6px;
    align-content: start;
    padding: 18px 20px 0 0;
    position: relative;
  }
  .flow li + li {
    padding-left: 20px;
    border-left: 1px solid var(--rule);
  }
  .flow strong {
    font-size: 19px;
    font-weight: 500;
  }
  .flow span:last-child {
    color: var(--body);
    font-size: 15px;
  }
  .milestones {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }
  .milestones li {
    display: grid;
    grid-template-columns: 88px 120px minmax(0, 1fr) 56px;
    gap: 24px;
    align-items: center;
    padding: 18px 0;
    border-top: 1px solid var(--rule);
  }
  .milestones .id {
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .milestones .bar {
    height: 16px;
    border: 1.5px solid var(--ink);
  }
  .milestones .done .bar {
    background: var(--ink);
  }
  .milestones .next .bar {
    border-color: var(--accent);
    border-width: 2px;
  }
  .milestones .next .id,
  .milestones .next .state {
    color: var(--accent);
  }
  .milestones .what {
    display: grid;
    gap: 2px;
  }
  .milestones .name {
    font-size: 19px;
    font-weight: 500;
  }
  .milestones .scope {
    color: var(--body);
  }
  .milestones .open .id,
  .milestones .open .name,
  .milestones .open .scope,
  .milestones .state {
    color: var(--mute);
  }
  .milestones .state {
    font-size: 12px;
    text-align: right;
  }
  .site-footer {
    margin-top: clamp(64px, 10vw, 128px);
    border-top: 1px solid var(--rule);
    padding: 20px 0 28px;
    font-size: 12px;
  }
  .footer-inner .fonts {
    flex-basis: 100%;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
  }
  @media (max-width: 860px) {
    .features li {
      grid-template-columns: 40px minmax(0, 1fr);
    }
    .features .text {
      grid-column: 2;
    }
    .gallery {
      grid-template-columns: minmax(0, 1fr);
    }
    .flow {
      grid-template-columns: minmax(0, 1fr);
      border-top: 0;
      border-left: 1.5px solid var(--ink);
    }
    .flow li,
    .flow li + li {
      padding: 0 0 22px 18px;
      border-left: 0;
    }
    .milestones li {
      grid-template-columns: 52px minmax(0, 1fr) auto;
      grid-template-areas:
        "id bar state"
        "id what what";
      gap: 8px 14px;
      align-items: start;
    }
    .milestones .id {
      grid-area: id;
    }
    .milestones .bar {
      grid-area: bar;
      align-self: center;
      height: 12px;
    }
    .milestones .what {
      grid-area: what;
    }
    .milestones .state {
      grid-area: state;
    }
  }
</style>
