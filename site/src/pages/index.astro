---
// SPDX-FileCopyrightText: 2026 David Däster <david@daester.net>
// SPDX-License-Identifier: GPL-3.0-or-later

import Base from "../layouts/Base.astro";
import RetentionTimeline from "../components/RetentionTimeline.astro";
import Lightbox from "../components/Lightbox.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import WindowFrame from "../components/WindowFrame.astro";
import appIcon from "../../../packaging/icons/hicolor/scalable/apps/kestic.svg";
import { heroShot, galleryShots } from "../screenshots.ts";
import { buildShaShort, commitUrl, release, repoUrl, screenshotsVersion } from "../build-info.ts";

const features = [
  {
    term: "Exclude rules",
    text: "Pick folders to skip, or switch to expert mode for raw restic patterns. A linter flags exceptions that can never match.",
  },
  {
    term: "Backup preview",
    text: "A dry run lists the files a backup would include and how much data it would add, before anything is written.",
  },
  {
    term: "Retention",
    text: "Keep the last few snapshots per hour, day, week, month, or year, or everything from a recent period. A preview shows which snapshots would go before anything is removed.",
  },
  {
    term: "Schedule",
    text: "Daily, on chosen weekdays, weekly, or every few days. Runs missed during sleep or shutdown are caught up, an unreachable destination is tried again later, and overdue backups are flagged.",
  },
  {
    term: "Source checks",
    text: "A backup of an external drive waits until that drive is plugged in. Sources that overlap on the same destination are flagged.",
  },
  {
    term: "Run conditions",
    text: "Only on AC power, only with a network, never on a metered connection, only on the Wi-Fi networks you allow.",
  },
  {
    term: "Maintenance",
    text: "Clean up frees the space of removed snapshots, Verify checks the repository for damage. Both run per destination on a calendar you set, wait for running backups, and start only on AC power and an unmetered network.",
  },
  {
    term: "Pause",
    text: "Hold all schedules for an hour, until tomorrow, or until you resume. Manual backups still run.",
  },
  {
    term: "Restore",
    text: "Browse a snapshot folder by folder, or search all snapshots of a backup for a file name, and mark what you want back. It goes into a new folder by default, so nothing is overwritten. At the original location, a home folder saved under another user name maps to yours.",
  },
  {
    term: "Restore preview",
    text: "Restoring to the original location or into a folder with files in it needs a preview first. It lists which files would be new, overwritten, not overwritten, or unchanged. Existing files stay as they are unless you pick an overwrite mode.",
  },
  {
    term: "Compare",
    text: "See what changed between two snapshots: new, changed, and removed files, filtered by kind.",
  },
  {
    term: "Unassigned snapshots",
    text: "Snapshots made with plain restic show up as unassigned, those of backups no longer known as orphaned. You can browse and restore them; Kestic only reads them.",
  },
  {
    term: "Destinations",
    text: "A local folder, an external drive (plugged-in drives are listed), a REST server, an SSH server (SFTP), S3-compatible storage, and Backblaze B2, Azure, Google Cloud, Swift, or any rclone remote. Types that need a program you have not installed name the package to install.",
  },
  {
    term: "SSH servers",
    text: "Kestic logs in with your SSH key or ssh-agent. It shows an unknown server's key fingerprint and keeps the key only after you trust it, and stops if a known server shows another key.",
  },
  {
    term: "Edit a connection",
    text: "Move a destination to another address or path, or change its credentials. Kestic checks that it is the same repository before it saves; another repository can be added as a new destination.",
  },
  {
    term: "Access data",
    text: "A destination uses only the access data entered for it, never cloud credentials, certificates, or logins found in the environment. Azure and Google Cloud need their own key or token, or an Azure CLI login you choose explicitly.",
  },
  {
    term: "restic source",
    text: "Automatic uses the system restic if it is 0.18.0 or newer, otherwise one managed by Kestic: the official release, downloaded only when you ask, checked against restic's signature, and never replaced while a run uses it. You can also pick the system restic or a path of your own.",
  },
  {
    term: "Native on Plasma",
    text: "A tray entry with Restore Files…, notifications, and progress in Plasma's notification area. Passwords stay in KWallet or another Secret Service password store. Sizes and percentages follow your locale.",
  },
] as const;

const milestones = [
  {
    id: "M0",
    name: "Spike",
    scope: "Toolchain proven: CXX-Qt, packaging, Secret Service, translations, tray.",
    done: true,
  },
  {
    id: "M1",
    name: "Walking skeleton",
    scope: "One backup through every layer, from the window to restic and back, installable as a .deb.",
    done: true,
  },
  {
    id: "M2",
    name: "Backup configuration",
    scope: "Exclude rules, retention with preview, source checks.",
    done: true,
  },
  {
    id: "M3",
    name: "Automation",
    scope: "Schedule, run conditions, retries, overdue backups, maintenance, sleep.",
    done: true,
  },
  {
    id: "M4",
    name: "Restore",
    scope: "Browse and compare snapshots, restore files, by default without overwriting existing ones.",
    done: true,
  },
  {
    id: "M5",
    name: "Destinations and restic provisioning",
    scope: "SFTP, S3, and the other restic backends, and a restic managed by Kestic where the system one is too old.",
    done: true,
  },
  {
    id: "M6",
    name: "Onboarding and security",
    scope: "Guided first backup in five steps, a recovery kit, and getting your data back on a new computer.",
    done: false,
  },
] as const;

const doneCount = milestones.filter((m) => m.done).length;
const nextMilestone = milestones.find((m) => !m.done);
const buildFromSource = `${repoUrl}#building--testing`;
const requirements =
  "Needs a Debian- or Ubuntu-based amd64 system with Plasma 6, KDE Frameworks 6.24 or newer, and Qt 6.10 or newer. Tested on TUXEDO OS 24.04.";
---

<Base
  title="Kestic: restic backups for KDE Plasma"
  description="A native KDE Plasma backup manager powered by restic. Pick what and where. Kestic does the rest and shows you the restic command behind every run."
>
  <div class="preview-bar mono">
    <div class="wrap">
      Development preview · {screenshotsVersion ?? "main"} @ <a href={commitUrl}>{buildShaShort}</a>{
        release ? (
          <span class="release-note">
            · latest release <a href={release.url}>{release.tag}</a>
          </span>
        ) : (
          <span class="release-note">· no release yet</span>
        )
      }
    </div>
  </div>

  <header class="site-header">
    <div class="wrap header-inner">
      <a class="wordmark" href={import.meta.env.BASE_URL} aria-label="Kestic home">
        <img src={appIcon.src} alt="" width="28" height="28" />
        <span>kestic</span>
      </a>
      <nav aria-label="Sections" class="mono">
        <a href="#features">Features</a>
        <a href="#screens">Screens</a>
        <a href="#roadmap">Roadmap</a>
        <a href="#try">Try it</a>
        <a href={repoUrl}>GitHub&nbsp;↗</a>
      </nav>
      <ThemeToggle />
    </div>
  </header>

  <Lightbox>
    <main id="main">
      <section class="hero wrap">
        <p class="mono accent eyebrow">
          <a href="#roadmap">{doneCount} of {milestones.length} milestones done</a>
        </p>
        <h1>
          <span>Backups that run themselves.</span>
          <span class="second">On Plasma. With restic.</span>
        </h1>
        <p class="lede">
          Pick what and where. Kestic does the rest and shows you the restic command behind every
          run.
        </p>
        <div class="actions">
          {
            release ? (
              <>
                <a class="button primary" href={release.debUrl}>Download {release.tag} (.deb, amd64)</a>
                <a class="button" href="#try">Try it</a>
              </>
            ) : (
              <a class="button primary" href="#try">Try it</a>
            )
          }
          <a class="button" href={repoUrl}>View on GitHub</a>
        </div>
        <dl class="mono facts">
          <dt>Today</dt>
          <dd>Back up to a local folder or drive, a REST or SSH server, S3 or another restic backend, and restore from your snapshots.</dd>
          <dt>Not yet</dt>
          <dd>Guided first-run setup and a recovery kit.</dd>
          <dt>Runs on</dt>
          <dd>
            Debian- and Ubuntu-based amd64 systems with Plasma 6, KDE Frameworks 6.24 or newer,
            and Qt 6.10 or newer. Tested on TUXEDO OS 24.04. Uses restic 0.18.0 or newer from the system,
            or downloads it for you.
          </dd>
        </dl>
      </section>

      <div class="wrap hero-shot">
        <WindowFrame shot={heroShot} number={1} eager />
        <p class="mono mute provenance">
          Rendered by the test suite at {screenshotsVersion ? `${screenshotsVersion} @ ` : ""}<a
            href={commitUrl}>{buildShaShort}</a>, like every screenshot on this page.
        </p>
      </div>

      <figure class="wrap timeline-hero">
        <RetentionTimeline />
        <figcaption class="mono mute">
          Retention as Kestic keeps it by default: the last 7 daily, 4 weekly, and 12 monthly
          snapshots.
        </figcaption>
      </figure>

      <section id="features" class="section wrap">
        <div class="section-head">
          <h2>What it does</h2>
          <p>
            All of this works today. Still missing: a guided first-run setup and a recovery kit.
          </p>
        </div>
        <ol class="features">
          {
            features.map((f, i) => (
              <li>
                <span class="num mono accent">{String(i + 1).padStart(2, "0")}</span>
                <span class="term">{f.term}</span>
                <span class="text">{f.text}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="screens" class="section wrap">
        <div class="section-head">
          <h2>Screens</h2>
          <p>
            Real screenshots, taken by the project's automated GUI tests, so you see their test data.
            Select a picture to see the whole window.
          </p>
        </div>
        <div class="gallery">
          {galleryShots.map((shot, i) => <WindowFrame shot={shot} number={i + 2} />)}
        </div>
      </section>

      <section id="roadmap" class="section wrap">
        <div class="section-head">
          <h2>Roadmap</h2>
          <p>
            {doneCount} of {milestones.length} milestones done.{" "}
            {nextMilestone ? `Next up: ${nextMilestone.id} ${nextMilestone.name}.` : "All milestones done."}{" "}
            Every story and acceptance criterion lives in the repository.
          </p>
        </div>
        <ol class="milestones">
          {
            milestones.map((m) => {
              const state = m.done ? "done" : m === nextMilestone ? "next" : "planned";
              return (
                <li class={state}>
                  <span class="id">{m.id}</span>
                  <span class="bar" aria-hidden="true" />
                  <span class="what">
                    <span class="name">{m.name}</span>
                    <span class="scope">{m.scope}</span>
                  </span>
                  <span class="mono state">{state}</span>
                </li>
              );
            })
          }
        </ol>
      </section>

      <div class="wrap section-divider" aria-hidden="true">
        <RetentionTimeline />
      </div>

      <section id="how" class="section wrap">
        <div class="section-head">
          <h2>Plain restic underneath</h2>
          <p>
            Every backup, maintenance run, and restore is an ordinary restic command. Kestic shows
            it in the history of every run, and next to each backup.
          </p>
        </div>
        <pre class="command mono" aria-label="Example restic command run by Kestic"><code><span class="comment"># What "Back Up Now" runs, as "Show Command" shows it (wrapped here)</span>
RESTIC_PASSWORD_COMMAND='kestic secret get k3n8x2qd' \
  ionice -c 3 nice -n 10 /usr/bin/restic -r rest:https://nas.example/kestic \
  --json backup --tag kestic:va757a3y --group-by tags \
  --exclude-file /home/you/.local/state/kestic/excludes/va757a3y.txt \
  --exclude-caches -- /home/you<span class="cursor" aria-hidden="true"></span></code></pre>
        <p class="note">
          Passwords never appear on the command line or in a config file. restic asks for them
          through <code class="mono">RESTIC_PASSWORD_COMMAND</code>, and Kestic reads them from the
          password store.
        </p>

        <ol class="flow" aria-label="How the parts work together">
          <li>
            <span class="mono accent">App</span>
            <strong>Kestic</strong>
            <span>Kirigami window for setup, status, history, and restore.</span>
          </li>
          <li>
            <span class="mono accent">D-Bus</span>
            <strong>Background service</strong>
            <span>Starts with your Plasma session and runs every backup, also with the window closed. No root rights, no systemd timers.</span>
          </li>
          <li>
            <span class="mono accent">Process</span>
            <strong>restic</strong>
            <span>restic 0.18.0 or newer does the actual work: the system one, or the one Kestic downloaded and checked.</span>
          </li>
          <li>
            <span class="mono accent">Repository</span>
            <strong>Destination</strong>
            <span>A local folder or drive, a REST or SSH server, S3-compatible storage, or another restic backend.</span>
          </li>
        </ol>
      </section>

      <section id="try" class="section wrap">
        {
          release ? (
            <>
              <div class="section-head">
                <h2>Try it</h2>
                <p>
                  Download the package of <a href={release.url}>{release.tag}</a> and install it
                  with apt. {requirements} Kestic uses restic 0.18.0 or newer; without one on the
                  system, it offers to download it.
                </p>
              </div>
              <pre class="command mono" aria-label="Commands to download and install Kestic"><code>wget {release.debUrl}
sudo apt install ./{release.debFile}</code></pre>
              <p class="note">
                Then open Kestic from the application menu. From now on its background service
                starts with your Plasma session. To build the package yourself instead, see{" "}
                <a href={buildFromSource}>Building and testing</a>.
              </p>
            </>
          ) : (
            <>
              <div class="section-head">
                <h2>Try it</h2>
                <p>
                  There is no release yet, so you build the package yourself. The bootstrap script
                  installs the Rust toolchain, the Qt and KDE development packages, and cargo-deb.
                  {requirements}
                </p>
              </div>
              <pre class="command mono" aria-label="Commands to build and install Kestic"><code>git clone {repoUrl}.git && cd kestic
./scripts/bootstrap.sh
just deb
sudo apt install ./target/debian/kestic_*.deb</code></pre>
              <p class="note">
                Then open Kestic from the application menu. From now on its background service
                starts with your Plasma session. <a href={buildFromSource}>Building and testing in detail</a>
              </p>
            </>
          )
        }
      </section>
    </main>
  </Lightbox>

  <footer class="site-footer mono">
    <div class="wrap footer-inner">
      <span>Kestic · GPL-3.0-or-later · <a href={repoUrl}>Source on GitHub</a></span>
      <span class="mute">Set in Schibsted Grotesk and IBM Plex Mono, both under the SIL Open Font License 1.1.</span>
    </div>
  </footer>
</Base>

<style>
  .preview-bar {
    border-bottom: 1px solid var(--rule);
    font-size: 13px;
    padding: 8px 0;
  }
  .site-header {
    border-bottom: 1px solid var(--rule);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    flex-wrap: wrap;
  }
  .wordmark {
    margin-right: auto;
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 21px;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .site-header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    color: var(--mute);
  }
  .site-header nav a {
    padding: 10px 0;
    text-decoration: none;
  }
  .site-header nav a:last-child {
    color: var(--ink);
  }
  .hero {
    padding-top: clamp(48px, 9vw, 120px);
  }
  .eyebrow {
    margin: 0 0 20px;
  }
  .eyebrow a {
    text-underline-offset: 4px;
  }
  .eyebrow::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 10px;
    background: currentColor;
    vertical-align: 1px;
  }
  h1 {
    margin: 0;
    font-size: clamp(44px, 9vw, 112px);
    line-height: 0.94;
    font-weight: 800;
    letter-spacing: -0.045em;
  }
  h1 span {
    display: block;
    text-wrap: balance;
  }
  h1 .second {
    color: var(--second);
  }
  .lede {
    max-width: 30em;
    margin: 32px 0 32px;
    font-size: clamp(18px, 2vw, 21px);
    color: var(--body);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .button {
    display: inline-block;
    padding: 12px 18px;
    border: 1.5px solid var(--ink);
    border-radius: 2px;
    font-weight: 500;
    font-size: 15px;
    text-decoration: none;
  }
  .button.primary {
    background: var(--ink);
    color: var(--paper);
  }
  .button:hover {
    border-color: var(--accent);
  }
  .button.primary:hover {
    background: var(--accent);
    color: var(--paper);
  }
  .facts {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 6px 16px;
    max-width: 48em;
    margin: 32px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
    font-size: 13px;
    line-height: 1.6;
  }
  .facts dt {
    color: var(--mute);
  }
  .facts dd {
    margin: 0;
    color: var(--body);
  }
  .facts code {
    color: var(--ink);
  }
  .hero-shot {
    padding-top: clamp(40px, 6vw, 64px);
  }
  .provenance {
    margin: 6px 0 0;
    font-size: 13px;
  }
  .timeline-hero {
    margin-top: clamp(48px, 7vw, 80px);
    margin-bottom: 0;
  }
  .timeline-hero figcaption {
    margin-top: 8px;
    font-size: 13px;
  }
  .features {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }
  .features li {
    display: grid;
    grid-template-columns: 56px minmax(0, 220px) minmax(0, 1fr);
    gap: 16px;
    padding: 20px 0;
    border-top: 1px solid var(--rule);
    align-items: baseline;
  }
  .features .term {
    font-weight: 500;
    font-size: 19px;
  }
  .features .text {
    color: var(--body);
    max-width: 38em;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px 32px;
  }
  .section-divider {
    padding-top: clamp(56px, 9vw, 112px);
  }
  .command {
    margin: 0;
    padding: 24px 26px;
    background: var(--block-bg);
    color: var(--block-text);
    border: 1px solid var(--rule);
    border-radius: 2px;
    font-size: 14px;
    line-height: 1.75;
    overflow-x: auto;
  }
  .command .comment {
    color: var(--block-mute);
  }
  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 4px;
    vertical-align: -0.15em;
    background: #ee9164;
  }
  .note {
    max-width: 38em;
    margin: 20px 0 0;
    color: var(--body);
  }
  .note code {
    font-size: 0.85em;
  }
  .flow {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1.5px solid var(--ink);
  }
  .flow li {
    display: grid;
    gap: 6px;
    align-content: start;
    padding: 18px 20px 0 0;
    position: relative;
  }
  .flow li + li {
    padding-left: 20px;
    border-left: 1px solid var(--rule);
  }
  .flow strong {
    font-size: 19px;
    font-weight: 500;
  }
  .flow span:last-child {
    color: var(--body);
    font-size: 15px;
  }
  .milestones {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }
  .milestones li {
    display: grid;
    grid-template-columns: 88px 120px minmax(0, 1fr) 56px;
    gap: 24px;
    align-items: center;
    padding: 18px 0;
    border-top: 1px solid var(--rule);
  }
  .milestones .id {
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .milestones .bar {
    height: 16px;
    border: 1.5px solid var(--ink);
  }
  .milestones .done .bar {
    background: var(--ink);
  }
  .milestones .next .bar {
    border-color: var(--accent);
    border-width: 2px;
  }
  .milestones .next .id,
  .milestones .next .state {
    color: var(--accent);
  }
  .milestones .what {
    display: grid;
    gap: 2px;
  }
  .milestones .name {
    font-size: 19px;
    font-weight: 500;
  }
  .milestones .scope {
    color: var(--body);
  }
  .milestones .planned .id,
  .milestones .planned .name,
  .milestones .planned .scope,
  .milestones .state {
    color: var(--mute);
  }
  .milestones .state {
    font-size: 13px;
    text-align: right;
  }
  .site-footer {
    margin-top: clamp(64px, 10vw, 128px);
    border-top: 1px solid var(--rule);
    padding: 20px 0 28px;
    font-size: 13px;
  }
  .footer-inner {
    display: grid;
    gap: 6px;
  }
  @media (max-width: 480px) {
    .site-header nav a:last-child,
    .preview-bar .release-note {
      display: none;
    }
    .facts {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
    .facts dd + dt {
      margin-top: 10px;
    }
  }
  @media (max-width: 860px) {
    .site-header nav {
      order: 3;
      flex-basis: 100%;
    }
    .features li {
      grid-template-columns: 40px minmax(0, 1fr);
    }
    .features .text {
      grid-column: 2;
    }
    .gallery {
      grid-template-columns: minmax(0, 1fr);
    }
    .flow {
      grid-template-columns: minmax(0, 1fr);
      border-top: 0;
      border-left: 1.5px solid var(--ink);
    }
    .flow li,
    .flow li + li {
      padding: 0 0 22px 18px;
      border-left: 0;
    }
    .milestones li {
      grid-template-columns: 52px minmax(0, 1fr) auto;
      grid-template-areas:
        "id bar state"
        "id what what";
      gap: 8px 14px;
      align-items: start;
    }
    .milestones .id {
      grid-area: id;
    }
    .milestones .bar {
      grid-area: bar;
      align-self: center;
      height: 12px;
    }
    .milestones .what {
      grid-area: what;
    }
    .milestones .state {
      grid-area: state;
    }
  }
</style>
