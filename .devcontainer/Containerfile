# Isolated container for a coding agent (Claude Code) working on Kestic.
#
# Base: the CI image (.github/ci-image/Dockerfile), so the agent builds and
# tests with exactly the system packages of the `verify` job. Its tag is the
# content hash printed by .github/ci-image/tag.sh; kestic-agent.sh always
# passes the current one. The default below is only for tools that cannot run
# that script (e.g. the devcontainer CLI); `kestic-agent.sh build` warns when
# it is stale.
#
# Added on top:
#   - egress firewall: nftables + dnsmasq (allowlisted domains only),
#   - gh, tmux, jq for the GitHub workflow,
#   - Claude Code (native binary, checksum from the release manifest),
#   - the scripts in this folder.
#
# Not in the image: the repository (cloned inside the container), the Rust
# toolchain and the restic test binaries (scripts/bootstrap.sh of the clone
# installs them into the home volume, so they always match the checked-out
# branch), any token or login.

ARG CI_IMAGE=ghcr.io/swissbite/kestic-ci:cb2162f5998cc773
FROM ${CI_IMAGE}

ARG CI_IMAGE
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        dnsmasq-base \
        gh \
        jq \
        less \
        nftables \
        tmux \
    && rm -rf /var/lib/apt/lists/*

# `stable`, `latest` or an exact version such as 2.1.323.
ARG CLAUDE_CODE_VERSION=stable
RUN set -eu; \
    base=https://downloads.claude.ai/claude-code-releases; \
    case "$(uname -m)" in x86_64) platform=linux-x64 ;; aarch64) platform=linux-arm64 ;; *) exit 1 ;; esac; \
    version="$CLAUDE_CODE_VERSION"; \
    case "$version" in stable|latest) version="$(curl -fsSL "$base/$version")" ;; esac; \
    echo "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; \
    checksum="$(curl -fsSL "$base/$version/manifest.json" | jq -r --arg p "$platform" '.platforms[$p].checksum')"; \
    echo "$checksum" | grep -Eq '^[0-9a-f]{64}$'; \
    curl -fsSL -o /usr/local/bin/claude "$base/$version/$platform/claude"; \
    echo "$checksum  /usr/local/bin/claude" | sha256sum -c -; \
    chmod 755 /usr/local/bin/claude

COPY --chmod=755 entrypoint.sh init-firewall.sh /usr/local/lib/kestic-agent/
COPY --chmod=755 kestic-agent-inner.sh /usr/local/bin/kestic-agent
COPY --chmod=755 gh-wrapper.sh /usr/local/bin/gh
COPY --chmod=755 git-hooks/ /usr/local/lib/kestic-agent/git-hooks/
COPY --chmod=644 allowed-domains.txt /usr/local/lib/kestic-agent/
COPY --chmod=644 agent-settings.json /usr/local/lib/kestic-agent/agent-settings.json
COPY --chmod=644 tmux.conf /etc/tmux.conf

# Owner of the container's main process (entrypoint.sh): a user of its own, so
# the agent cannot end the container by signalling it.
RUN useradd --system --no-create-home --home-dir / --shell /usr/sbin/nologin kestic-infra

# Mount points of the two volumes and the (empty) clone directory, which is
# the Dev Container workspace; a new volume copies this ownership.
RUN mkdir -p /home/kesticci/.claude /home/kesticci/kestic \
    && chown -R kesticci:kesticci /home/kesticci

# No CARGO_INCREMENTAL here: unlike CI, the agent keeps its target directory
# between builds, so cargo's default (incremental for workspace crates in the
# dev profile) makes each edit-and-rebuild loop several times faster.
ENV KESTIC_CI_IMAGE=${CI_IMAGE} \
    CLAUDE_CONFIG_DIR=/home/kesticci/.claude \
    DISABLE_AUTOUPDATER=1 \
    DISABLE_TELEMETRY=1 \
    DISABLE_ERROR_REPORTING=1 \
    PATH=/home/kesticci/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=en_US.UTF-8

# Starts as root only to set up the firewall, then runs the main command as
# `kestic-infra` without any capabilities; the agent runs as `kesticci` through
# `podman exec` (entrypoint.sh).
WORKDIR /home/kesticci
ENTRYPOINT ["/usr/local/lib/kestic-agent/entrypoint.sh"]
CMD ["sleep", "infinity"]
