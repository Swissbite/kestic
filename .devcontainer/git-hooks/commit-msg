#
# Rejects commit messages that name an AI tool as author or co-author.

set -euo pipefail

if grep -Eiq '^co-authored-by:.*(claude|anthropic|copilot|openai|codex|gemini|antigravity)|generated (with|by) .*(claude|copilot|codex|gemini|antigravity)' "$1"; then
    echo "commit-msg: remove the AI attribution (Co-Authored-By / Generated with); agents commit without it" >&2
    exit 1
fi
