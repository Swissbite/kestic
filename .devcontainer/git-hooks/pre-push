# Agents push only their own branches; main changes through reviewed pull requests.

set -euo pipefail

while read -r _local_ref _local_sha remote_ref _remote_sha; do
    if [[ "$remote_ref" == refs/heads/main ]]; then
        echo "pre-push: pushing to main is not allowed; open a pull request" >&2
        exit 1
    fi
done
