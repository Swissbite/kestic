#
# Kestic instance of the Leitstand skill (.agents/skills/leitstand). Copy to
# ${XDG_CONFIG_HOME:-~/.config}/leitstand/kestic.env and fill in the values marked "ask".

# ask: where the Leitstand knowledge for Kestic lives (the maintainer knows).
LEITSTAND_KNOWLEDGE=

# ask: the local checkout of Swissbite/kestic.
LEITSTAND_REPO=

LEITSTAND_MAINTAINER=Swissbite

# One entry per agent container; update at each milestone kickoff.
LEITSTAND_AGENTS="kestic-agent-2|m6|M6 Onboarding and security"

LEITSTAND_AGENT_STATE='KESTIC_AGENT_NAME={agent} .devcontainer/kestic-agent.sh agent-state'
LEITSTAND_AGENT_PANE='podman exec -u kesticci {agent} tmux capture-pane -p -J -t agent'
LEITSTAND_AGENT_MESSAGE='KESTIC_AGENT_NAME={agent} .devcontainer/kestic-agent.sh nudge'

LEITSTAND_CHECKS="verify CodeQL"
LEITSTAND_MAIN_PRS=
LEITSTAND_SUBAGENT_MAX_MIN=25
LEITSTAND_DISK_MIN_GB=25
