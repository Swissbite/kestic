# Leitstand instance file. Copy to ${XDG_CONFIG_HOME:-~/.config}/leitstand/<project>.env and fill
# in every value marked "ask" with the human. Keep it out of the repository: it holds private paths.

# ask: where the project knowledge lives (mandate, rules, lessons, milestone state).
LEITSTAND_KNOWLEDGE=

# ask: the local checkout the forge commands run in.
LEITSTAND_REPO=

# The forge login that writes the maintainer's comments (the Leitstand acts under it).
LEITSTAND_MAINTAINER=

# Agents at work: "<agent>|<integration branch>|<milestone title>", several separated by ";".
LEITSTAND_AGENTS=

# Adapters; {agent} is replaced by the agent name. Empty disables the check.
# Prints the agent state first ("busy", "idle" or anything else).
LEITSTAND_AGENT_STATE=
# Prints the agent's console (the last screen is enough).
LEITSTAND_AGENT_PANE=
# Sends a message to the agent session; the text follows as the last argument.
LEITSTAND_AGENT_MESSAGE=

# Required checks that decide red or ready.
LEITSTAND_CHECKS="verify CodeQL"

# Pull requests into the default branch the human approved to merge once green.
LEITSTAND_MAIN_PRS=

LEITSTAND_SUBAGENT_MAX_MIN=25
LEITSTAND_DISK_MIN_GB=25
