[Desktop Entry]
Type=Application
Name=Kestic Background Service
Name[de]=Kestic-Hintergrunddienst
GenericName=Backup Monitor
GenericName[de]=Sicherungs-Überwachung
Exec=kestic daemon --autostart
TryExec=/usr/bin/kestic
Icon=kestic
Terminal=false
NoDisplay=true
X-KDE-StartupNotify=false
Categories=Qt;KDE;Utility;
